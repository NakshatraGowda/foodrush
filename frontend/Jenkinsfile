pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'mvn3'
        nodejs 'nodejs20'
    }
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }
    stages {
        stage('Git checkout') {
            steps {
                git branch : 'main', url: 'https://github.com/NakshatraGowda/foodrush'
            }
        }
        stage('Check Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: 'git diff --name-only HEAD~1 HEAD',
                        returnStdout: true
                    ).trim()

                    echo 'Changed files:'
                    echo changedFiles

                    if (!changedFiles.split('\n').any {
                        it.startsWith('frontend/')
                    }) {
                        currentBuild.result = 'NOT_BUILT'
                        error('No frontend changes. Skipping.')
                    }
                }
            }
        }
        stage('build and test') {
            steps {
                dir('frontend') {
                    sh '''
                        node -v
                        npm -v
                        npm ci
                        npm run build
                    '''
                }
            }
        }
        stage('sonarqube analysis') {
            steps {
                dir('frontend') {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.host.url=http://localhost:9000 \
                        -Dsonar.login=squ_6ee255a90792a5174acdacf77e41142984c21372 \
                        -Dsonar.projectName=foodrush-frontend \
                        -Dsonar.projectKey=foodrush-frontend \
                        -Dsonar.java.binaries=target/classes \
                    '''
                }
            }
        }
        stage('Build docker image') {
            steps {
                dir('frontend') {
                    sh 'docker build -t nakshatragowda/frontend:${BUILD_NUMBER} .'
                }
            }
        }
        stage('push to dockerhub') {
            steps {
                withDockerRegistry(credentialsId: 'docker-creds', url: 'https://index.docker.io/v1/') {
                    sh 'docker push nakshatragowda/frontend:${BUILD_NUMBER}'
                }
            }
        }
        stage('Trigger CD') {
            steps {
                steps {
                    build job: 'api-gateway-cd',
                    parameters: [
                        string(
                            name: 'IMAGE_TAG',
                            value: "${BUILD_NUMBER}"
                        )
                    ],
                    wait: true
                }
            }
        }
    }
}
